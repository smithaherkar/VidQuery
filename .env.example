# ── VidQuery Environment Configuration ───────────────────────────────────

# Mistral AI API Key (Required for Summarization, Extraction & RAG)
# Obtain your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key (Required ONLY for Hinglish transcription & translation)
# Obtain your key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional Configurations
# Whisper Model size for English transcription: tiny, base, small, medium, large
WHISPER_MODEL=small

# Sarvam STT Model for Hinglish: saaras:v2.5
SARVAM_STT_MODEL=saaras:v2.5
